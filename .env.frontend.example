# Copy this to the FRONTEND repo (Solar-Client/.env), not the backend.
# The Solar-Client app currently ships only a .env.example, so
# EXPO_PUBLIC_API_URL resolves to undefined at runtime -- axios then has
# no baseURL, every request fails, and the dashboard falls back to its
# "Waiting for first reading…" empty state even while the ESP is
# publishing normally and the backend is storing data correctly.

EXPO_PUBLIC_API_URL=https://school-project-ifbq.onrender.com
EXPO_PUBLIC_API_KEY=solar-pipeline-secret-key-2026
